% begin CMap dictionary: F1_CMap
10 dict begin
begincmap
/CMapType 1 def
/CMapName /F1_CMap def
/CIDSystemInfo 3 dict dup begin
    /Registry (cpsFontConverter-Synthetic-Registry) def
    /Ordering (cpsFontConverter-Synthetic-Ordering) def
    /Supplement 1 def
end def
1 begincodespacerange
  <0000> <FFFF>
endcodespacerange
0 usefont
1 begincidrange
  <0000> <FFFF> 0
endcidrange
endcmap
CMapName currentdict end /CMap defineresource pop
% end CMap dictionary: F1_CMap
/F1 /F1_CMap [/F1_CIDFont] composefont pop
end
