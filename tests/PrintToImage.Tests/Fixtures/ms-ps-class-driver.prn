%%BeginResource: procset cps_Header 1.0 0
userdict /GSdict 200 dict dup begin put/bd{bind def}bind def/d/def load def
/,/load load d/$/roll , d/~/exch , d/S/show , d/xS/xshow , d/yS/yshow , d
/xyS/xyshow , d/m/moveto , d/l/lineto , d/np/newpath , d/cp/closepath , d
/sj/setlinejoin , d/sd/setdash , d/sw/setlinewidth , d/sc/setlinecap , d
/ff/findfont , d/sf/setfont , d/sg/setgray , d/rgb/setrgbcolor , d/^/index , d
/:/gsave , d/;/grestore , d/++/concat , d/rf/rectfill , d/rc/rectclip , d
/crs/cliprestore , d/ed{~ d}bd/rec{m 1 ^ 0 l 0 ~ l neg 0 l cp}bd
/rc3{crs rectclip}bd/s/stroke , d/ef/eofill , d/f/fill , d/xl/translate , d
/MF{~ selectfont}bd/EA{1 ^ 0/G0 put 4 string 1 1 4 -1 ${3 copy neg ~ cvs dup
0 71 put cvn 3 -1 $ ~ put}for pop}bd userdict begin/B{pop pop pop pop}bd
/max{2 copy lt{~}if pop}bd/min{2 copy gt{~}if pop}bd /iclip/initclip , d
/sm/setmiterlimit , d/c/curveto , d/-- {matrix invertmatrix concat}bd
/csv/clipsave , d/cpt/currentpoint , d
/simpInitG{0 sg 1 sw 1 sc 0 sj 10 sm []0 sd}bd
/con{50 sub 100 div 1 ^ 0.5 sub mul add 1.0 min 0.0 max}bd
/br{50 sub 100 div add 1.0 min 0.0 max}bd
/ml{moveto{lineto}repeat}bd/lr{{lineto}repeat}bd
/cl/clip , d/ec/eoclip , d/ms{makepattern setpattern}bd
/tileDict{8 dict dup begin/PatternType 1 d/PaintType 1 d
  /TilingType 1 d}bd/im{image newpath}d
/featsentinel 21690 d
/featurebegin{countdictstack featsentinel[}bd
/featurecleanup{stopped{cleartomark dup 21690 eq{pop exit}if}loop 
    countdictstack exch sub dup 0 gt{{end}repeat}{pop}ifelse}bd
end
%%EndResource
%%BeginResource: procset cps_errorHandler 1.0 0
% Error Dictionary:
errordict begin
/handleerror{initgraphics 200 200 m 0 sg showpage 100 720 moveto
/Courier findfont 10 scalefont setfont
(ERROR: )show errordict begin $error begin errorname =string cvs show
cpt ~ pop 100 ~ 10 sub m
(OFFENDING COMMAND: )show /command load =string cvs show
2{cpt ~ pop 100 ~ 10 sub m}repeat
(OPERAND STACK: )show $error/ostack known{ostack aload length{=string
cvs cpt ~ pop 100 ~ 10 sub m
show}repeat}if end end showpage stop}bd end
%%EndResource
%%BeginResource: procset cps_Glyphs 1.0 0
% Glyphs function:
/gg {userdict begin /msave save def /indices exch def
/numIndices indices 0 eq{0}{indices length}ifelse def
/bidiLevel exch def /isSideways exch def
/styleSimulations exch def moveto
/uri exch def /em exch def /uni exch def
uri findfont em scalefont setfont
styleSimulations 2 eq styleSimulations 3 eq or{
 isSideways 1 eq{[1 17.547001 sin 17.547001 cos div 0 1 0 0]}
 {[1 0 17.547001 sin 17.547001 cos div -1 mul 1 0 0]}ifelse concat}if
bidiLevel 0 eq styleSimulations 0 eq styleSimulations 2 eq
or and indices 0 eq and { 1 -1 scale uni show }
{/xAdvance 0 def /yAdvance 0 def /charPosition 0 def
{/yW exch def /xW exch def /charCode exch def
 currentpoint /yOrigin exch def /xOrigin exch def
 /xAdvance xOrigin xW add def /yAdvance yOrigin yW sub def
 bidiLevel 1 eq {
 styleSimulations 1 eq styleSimulations 3 eq or {
                 /xAdvance xOrigin xW sub 0.015 em mul sub def
                 /yAdvance yOrigin yW sub def}{
                 /xAdvance xOrigin xW sub def
                 /yAdvance yOrigin yW sub def}ifelse
 xAdvance yAdvance moveto}
 {styleSimulations 1 eq styleSimulations 3 eq or {
   isSideways 1 eq {
     /xAdvance xOrigin xW add def
     /yAdvance yOrigin yW sub 0.015 em mul add def}{
     /xAdvance xOrigin xW add 0.015 em mul add def
     /yAdvance yOrigin yW add def}ifelse}if}ifelse
indices 0 ne charPosition numIndices lt and{
 indices charPosition get length 1 gt{
 /myIndex indices charPosition get def
 currentpoint /currY exch def /currX exch def
 bidiLevel 1 eq{currX myIndex 1 get em 100 div mul sub
                currY myIndex 2 get em 100 div mul sub}{
   isSideways 1 eq { currX myIndex 2 get em 100 div mul add
                     currY myIndex 1 get em 100 div mul add}{
                     currX myIndex 1 get em 100 div mul add
                     currY myIndex 2 get em 100 div mul sub}
                    ifelse}ifelse moveto}if}if
styleSimulations 1 eq styleSimulations 3 eq or{
 1 string dup 0 charCode put 1 -1 scale true charpath
 1 -1 scale gsave 0.015 em mul sw 1 sj stroke grestore
 fill}{1 -1 scale 1 string dup 0 charCode put show 1 -1 scale
 }ifelse
indices 0 ne charPosition numIndices lt and{
 indices charPosition get length 0 gt{
  /advWidth indices charPosition get 0 get def
  advWidth -1 ne{isSideways 1 eq{
   /yAdvance yOrigin advWidth em 100 div mul add def
   /xAdvance xOrigin def}{
   bidiLevel 1 eq{
     /xAdvance xOrigin advWidth em 100 div mul sub def}{
     /xAdvance xOrigin advWidth em 100 div mul add def}ifelse
   }ifelse}if}if}if xAdvance yAdvance moveto
 /charPosition charPosition 1 add def
}uni cshow}ifelse msave restore end}bind def
%%EndResource
%%BeginResource: procset cps_Fill16Incr 1.0 0
% fill16Incr function
/fill16Incr {
dup length 2 div 1 sub 0 1 3 -1 roll {
2 mul 3 copy 3 copy     %i st ind, i st ind, i st ind
dup 2 div 4 -1 roll add %i st ind, i st ind, st ind (ind/2+i)
cvi -8 bitshift put     %i st ind, i st ind [put in low bits]
dup 1 add exch 2 div    %i st ind, i st (ind+1) (ind/2)
4 -1 roll add           %i st ind, st (ind+1) (ind/2+i)
cvi 255 and put pop     %i st [put in high bits]
}for pop pop}bd
%%EndResource
%%BeginResource: procset cps_paintTile 1.0 0
% paintTile function
/paintTile {
userdict begin /mSave save d
/mode ~ d/vBox ~ d/bounds ~ d/tile ~ d
/xStep vBox 2 get vBox 0 get sub d
/yStep vBox 3 get vBox 1 get sub d
/flipX false d/flipY false d
/xStart bounds 0 get xStep div floor dup
  mode 2 eq mode 4 eq or
  {abs cvi 2 mod 0 ne{/flipX true d}if}{pop}ifelse
  xStep mul d
/flipXRestart flipX d
/yStart bounds 1 get yStep div floor dup
  mode 3 eq mode 4 eq or
  {abs cvi 2 mod 0 ne{/flipY true d}if}{pop}ifelse
  yStep mul d
mode 0 eq{vBox 0 get vBox 1 get vBox 2 get vBox 0 get sub
vBox 3 get vBox 1 get sub rc tile}
{yStart yStep bounds 3 get{/yPos ~ d
xStart xStep bounds 2 get{/xPos ~ d
gsave xPos vBox 0 get add yPos vBox 1 get add xStep yStep rectclip
flipX not flipY not and{[1 0 0 1 xPos yPos]++}if
flipX flipY not and{[-1 0 0 1 xPos xStep add yPos]++}if
flipX not flipY and{[1 0 0 -1 xPos yPos yStep add]++}if
flipX flipY and{[-1 0 0 -1 xPos xStep add yPos yStep add]++}if
tile grestore
mode 2 eq mode 4 eq or{/flipX flipX not d}if
}for /flipX flipXRestart d
mode 3 eq mode 4 eq or{/flipY flipY not d}if
}for}ifelse mSave restore end}bd
%%EndResource
%%BeginResource: procset cps_resFontSupport 1.0 0
% Support for re-encoding resident fonts.
/RMF{ff ~ makefont}bd
/IsChar{~/CharStrings get ~ known}bd/MapCh{3 -1 $/Encoding get 3 1
$ put}bd/MapDegree{dup 16#b0 ~/degree IsChar{/degree}{/ring}ifelse MapCh}
bd/MapBB{dup 16#a6 ~/brokenbar IsChar{/brokenbar}{/bar}ifelse MapCh}bd
/reencode{begin currentdict dup length dict begin{1 ^/FID ne{d}
{pop pop}ifelse}forall/FontName ed dup length 0 ne{/Encoding Encoding 256
array copy d 0 ~{dup type/nametype eq{Encoding 2 ^ 2 ^ put pop 1
add}{~ pop}ifelse}forall}if pop currentdict dup end end/FontName get ~
definefont dup MapDegree MapBB}bd/nds{{/.notdef}repeat}bd
/nf{dup 3 -1 $ ff 4 -1 $ 3 1 $ reencode RMF}bd
%%EndResource
%%BeginResource: procset cps_globalImgSupport 1.0 0
% Support for using one global image holder
/gImgDict<</curr 0 d/data 1 array d/currMask 0 d/mask 1 array>>d
/gii{/strNum ~ d gImgDict /data strNum array put
strNum 1 sub -1 0{gImgDict/data get ~ 3 -1 roll put}for}bd
/ggi{}bd
/gimi{/strNum ~ d gImgDict /mask strNum array put
strNum 1 sub -1 0{gImgDict/mask get ~ 3 -1 roll put}for}bd
/ggim{gImgDict/currMask 0 put
 {gImgDict/mask get gImgDict/currMask get get
 gImgDict/currMask gImgDict/currMask get 1 add
 gImgDict/mask get length mod put}
 /FlateDecode filter}bd
%%EndResource
%%BeginResource: procset cps_imgdict 1.0 0
/ID{7 dict dup 9 1 $
begin/DataSource ~ d/ImageMatrix ~ d/BitsPerComponent ~ d/Height ~ d
/Width ~ d/Decode ~ d/ImageType ~ d end}bd
%%EndResource
