<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PrintToImageSettings</AssemblyName>
    <RootNamespace>PrintToImageSettings</RootNamespace>
    <Version>1.0.0</Version>
    <Product>PrintToImage Settings</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same settings and name-handling code as the service, so validation and previews match exactly. -->
    <Compile Include="..\PrintToImage\Settings.cs" Link="Shared\Settings.cs" />
    <Compile Include="..\PrintToImage\JobNameParser.cs" Link="Shared\JobNameParser.cs" />
    <Compile Include="..\PrintToImage\JobNameResolver.cs" Link="Shared\JobNameResolver.cs" />
    <Compile Include="..\PrintToImage\OutputWriter.cs" Link="Shared\OutputWriter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

</Project>
